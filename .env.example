# Cloudflare R2, solo sul server (Vercel Production e Preview).
# Senza queste variabili l’app scatta lo stesso e la coda ritenta.
# Non committare i valori.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=siderio-vcad-foto

# Siderio Suite (Supabase Auth). URL e chiave pubblica sono già nel codice.
# Impostale solo per puntare a un altro progetto. Un valore vuoto chiude l’accesso.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chi è amministratore. Default: is_master. Per allargare: is_master,ruolo:Manager
# VCAD_ADMIN_RULE=

# Invio al motore. Senza queste due il pulsante spiega che mancano.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
