# Cloudflare R2, solo sul server (Vercel Production e Preview).
# Senza queste variabili l’app scatta lo stesso e la coda ritenta.
# Non committare i valori.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=siderio-vcad-foto

# Codice condiviso per aprire l’elenco e modificare i rilievi.
# Se manca, le route di lettura e scrittura restano chiuse.
# APP_ACCESS_CODE=
# Firma del cookie. Se manca, si deriva dal codice.
# APP_SESSION_SECRET=

# Invio al motore. Senza queste due il pulsante spiega che mancano.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
